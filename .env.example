# Copie este arquivo para ".env" (na raiz do repositório) e preencha os valores.
# O .env é lido pelo docker compose e pelo backend. Nunca versione o .env.

DB_NAME=ifo_db
DB_USER=ifo
DB_PASSWORD=troque-esta-senha
DB_URL=jdbc:postgresql://localhost:5432/ifo_db

# Chave do JWT: no mínimo 32 caracteres aleatórios.
# Gere uma com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres

# Origem do frontend liberada no CORS (Live Server usa a porta 5500).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Só em produção (painel do Render; não precisa no .env local) ---
# JWT_EXPIRACAO_MINUTOS=480
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://<host-direto-do-neon>/<banco>?sslmode=require
# CORS_ORIGINS=https://<seu-site>.vercel.app
# O Render define PORT sozinho; localmente a API usa 8081.